{
  "name": "Video Actions",
  "description": "Injects actions to the video player for popular video sites",
  "version": "1.0",
  "manifest_version": 3,
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": ["inject.js"]
    }
  ],
  "commands": {
    "a_toggle": {
      "suggested_key": { "default": "Ctrl+I", "mac": "Command+I" },
      "description": "Toggle video view"
    }
  }
}
